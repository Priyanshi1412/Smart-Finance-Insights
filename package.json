{
  "name": "smart-finance-insights",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "axios": "^1.18.1",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.4",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
