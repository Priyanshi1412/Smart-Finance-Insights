    "mongodb": "^7.5.0",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "scripts": {
    "postinstall": "cd backend && npm install && cd ../frontend && npm install",
